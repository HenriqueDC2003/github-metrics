        "operation": "executeQuery",
        "query": "INSERT INTO github_repos (repo_name, linguagem, estrelas, forks, issues_abertas, tamanho_kb, ultimo_push, data_coleta)\nVALUES (\n  '{{ $json.repo_name }}',\n  '{{ $json.linguagem }}',\n  {{ $json.estrelas }},\n  {{ $json.forks }},\n  {{ $json.issues_abertas }},\n  {{ $json.tamanho_kb }},\n  '{{ $json.ultimo_push }}',\n  '{{ $json.data_coleta }}'\n)\nON CONFLICT (repo_name, data_coleta)\nDO UPDATE SET\n  estrelas = EXCLUDED.estrelas,\n  forks = EXCLUDED.forks,\n  issues_abertas = EXCLUDED.issues_abertas,\n  tamanho_kb = EXCLUDED.tamanho_kb,\n  ultimo_push = EXCLUDED.ultimo_push,\n  linguagem = EXCLUDED.linguagem;",
