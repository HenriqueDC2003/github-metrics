    {
      "parameters": {
        "jsCode": "const repos = $input.all().map(item => item.json);\nconst hoje = new Date().toISOString().split('T')[0];\nconst dadosLimpos = [];\n\nfor (const repo of repos) {\n  if (repo.fork) continue;\n\n  dadosLimpos.push({\n    json: {\n      repo_name: repo.name,\n      linguagem: repo.language || 'Não especificado',\n      estrelas: repo.stargazers_count || 0,\n      forks: repo.forks_count || 0,\n      issues_abertas: repo.open_issues_count || 0,\n      tamanho_kb: repo.size || 0,\n      ultimo_push: repo.pushed_at,\n      data_coleta: hoje\n    }\n  });\n}\n\nreturn dadosLimpos;"
      },
